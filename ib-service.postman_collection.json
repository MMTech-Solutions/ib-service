{
    "info": {
        "_postman_id": "a8dfaa36-0cdc-48ca-a136-02338111763f",
        "name": "IB Service",
        "description": "HTTP routes exposed by IB Service. Administration and customer routes are separated by RBAC surface. Prepare the local RBAC fixtures with: php artisan db:seed --class=LocalRbacSnapshotSeeder --no-interaction.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "Service",
            "item": [
                {
                    "name": "Welcome",
                    "request": {
                        "method": "GET",
                        "header": [{"key": "Accept", "value": "text/html"}],
                        "url": {
                            "raw": "{{BASE_URL}}/",
                            "host": ["{{BASE_URL}}"],
                            "path": [""]
                        },
                        "description": "Default application landing route."
                    },
                    "response": []
                },
                {
                    "name": "Health check",
                    "request": {
                        "method": "GET",
                        "header": [{"key": "Accept", "value": "application/json"}],
                        "url": {
                            "raw": "{{BASE_URL}}/up",
                            "host": ["{{BASE_URL}}"],
                            "path": ["up"]
                        },
                        "description": "Laravel operational health endpoint configured in bootstrap/app.php."
                    },
                    "response": []
                }
            ]
        },
        {
            "name": "Administration",
            "description": "Routes whose /admin path resolves the admin_panel RBAC surface. Gateway requests use ADMIN_USERINFO.",
            "item": [
                {
                    "name": "Modules",
                    "item": [
                        {
                            "name": "List modules",
                            "request": {
                                "method": "GET",
                                "header": [
                                    {"key": "Accept", "value": "application/json"},
                                    {"key": "X-Internal-Gateway", "value": "{{GATEWAY_INTERNAL_SECRET}}", "type": "text"},
                                    {"key": "X-Userinfo", "value": "{{ADMIN_USERINFO}}", "type": "text"}
                                ],
                                "url": {
                                    "raw": "{{BASE_URL}}/api/ib/v1/admin/modules?page=1&per_page=100&search=broker&is_active=true&processing_status=running",
                                    "host": ["{{BASE_URL}}"],
                                    "path": ["api", "ib", "v1", "admin", "modules"],
                                    "query": [
                                        {"key": "page", "value": "1", "description": "Positive page number. Defaults to 1.", "disabled": true},
                                        {"key": "per_page", "value": "100", "description": "Results per page from 1 to 100. Defaults to 100.", "disabled": true},
                                        {"key": "search", "value": "broker", "description": "Case-insensitive search by module code or name.", "disabled": true},
                                        {"key": "is_active", "value": "true", "description": "Filter by active state: true or false.", "disabled": true},
                                        {"key": "processing_status", "value": "running", "description": "Filter by processing status: running or paused.", "disabled": true}
                                    ]
                                },
                                "description": "Requires ib.modules.manage on the admin_panel surface. Returns modules ordered by code, including active and inactive capabilities."
                            },
                            "response": []
                        }
                    ]
                }
            ]
        },
        {
            "name": "Customers",
            "description": "Customer routes resolve the customer_app RBAC surface and must use CUSTOMER_USERINFO. No customer HTTP routes are implemented yet.",
            "item": []
        }
    ],
